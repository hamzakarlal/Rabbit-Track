rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents: Only owner can read/write their user record
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Farm isolated documents:
    // Every collection under farms/{farmId} is isolated to authenticated users
    match /farms/{farmId} {
      allow read, write: if request.auth != null;

      match /rabbits/{rabbitId} {
        allow read, write: if request.auth != null;
      }

      match /breeding/{breedingId} {
        allow read, write: if request.auth != null;
      }

      match /kindlings/{kindlingId} {
        allow read, write: if request.auth != null;
      }

      match /healthRecords/{healthId} {
        allow read, write: if request.auth != null;
      }

      match /vaccinations/{vaccinationId} {
        allow read, write: if request.auth != null;
      }

      match /feeding/{feedingId} {
        allow read, write: if request.auth != null;
      }

      match /expenses/{expenseId} {
        allow read, write: if request.auth != null;
      }

      match /inventory/{inventoryId} {
        allow read, write: if request.auth != null;
      }

      match /sales/{saleId} {
        allow read, write: if request.auth != null;
      }

      match /notifications/{notificationId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
